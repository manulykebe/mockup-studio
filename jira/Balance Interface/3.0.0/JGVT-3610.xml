                                                <customfield id="customfield_10300" key="com.atlassian.jira.plugin.system.customfieldtypes:textarea">
                        <customfieldname>Acceptance Criteria</customfieldname>
                        <customfieldvalues>
                            <customfieldvalue>&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;Given&lt;/font&gt;&lt;/p&gt;
&lt;ul&gt;
	&lt;li&gt;&lt;font color=&quot;#172b4d&quot;&gt;A Signals Experiment with&lt;/font&gt;
	&lt;ul&gt;
		&lt;li&gt;&lt;font color=&quot;#172b4d&quot;&gt;one or more hub-connected balances in the Equipment Table (Equipment Class = Balance)&lt;/font&gt;&lt;/li&gt;
		&lt;li&gt;&lt;font color=&quot;#172b4d&quot;&gt;Sub Preparation Tables (with external action)&lt;/font&gt;&lt;/li&gt;
	&lt;/ul&gt;
	&lt;/li&gt;
	&lt;li&gt;&lt;font color=&quot;#172b4d&quot;&gt;The User has added one or more internal references to &apos;GxP CISPro Materials&apos;, &apos;GxP Biovia Samples &apos;or &apos;GxP Preparations&apos; in the Preparations sub table.&lt;/font&gt;&lt;/li&gt;
	&lt;li&gt;&lt;font color=&quot;#172b4d&quot;&gt;The User has launched the Balance interface from the Sub Table&lt;/font&gt;&lt;/li&gt;
	&lt;li&gt;&lt;font color=&quot;#172b4d&quot;&gt;The selected (physical) Balance displays a negative weigh measurement&#160;&#160;&lt;/font&gt;&lt;/li&gt;
&lt;/ul&gt;


&lt;p&gt;&lt;b&gt;When&lt;/b&gt; a User gets an actual negative amount from the selected Balance for each row in the Preparation table&lt;/p&gt;

&lt;p&gt;&lt;b&gt;Then&lt;/b&gt;&#160;&#160;&lt;/p&gt;
&lt;ul&gt;
	&lt;li&gt;&lt;font color=&quot;#172b4d&quot;&gt;The System shall populate the negative weigh measurement on the physical balance display in the balance data Field.&lt;/font&gt;&lt;/li&gt;
	&lt;li&gt;&lt;font color=&quot;#172b4d&quot;&gt; &apos;Actual Amt&apos; property of the Preparations Sub table with the absolute value of the actual amount in the dialog window.&#160;&lt;/font&gt;&lt;/li&gt;
&lt;/ul&gt;
</customfieldvalue>

                        </customfieldvalues>
