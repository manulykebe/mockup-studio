                <customfields>
                                                <customfield id="customfield_10300" key="com.atlassian.jira.plugin.system.customfieldtypes:textarea">
                        <customfieldname>Acceptance Criteria</customfieldname>
                        <customfieldvalues>
                            <customfieldvalue>&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;1) Initial Measure commit to |RfC suffix columns&lt;/b&gt;&lt;b&gt;{&lt;/b&gt;}&lt;/font&gt;&lt;/p&gt;

&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;Given&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;
&lt;ul&gt;
	&lt;li&gt;&lt;font color=&quot;#172b4d&quot;&gt;A Signals Experiment using a &lt;b&gt;GxP-GMP&lt;/b&gt; Template with&lt;/font&gt;
	&lt;ul&gt;
		&lt;li&gt;&lt;font color=&quot;#172b4d&quot;&gt;one or more hub-connected balances in the Equipment Table (Equipment Class = Balance)&lt;/font&gt;&lt;/li&gt;
		&lt;li&gt;&lt;font color=&quot;#172b4d&quot;&gt;Table Template Preparation Sub (with external action)&lt;/font&gt;&lt;/li&gt;
	&lt;/ul&gt;
	&lt;/li&gt;
	&lt;li&gt;&lt;font color=&quot;#172b4d&quot;&gt;The User has added one or more internal references to items from &apos;GxP CISPro Materials&apos;, &apos;GxP Biovia Samples&apos; or &apos;GxP Preparations&apos; in the Preparations sub table with RfC| prefix and |RfC suffix columns (with external action) with one or more preparations.&lt;/font&gt;&lt;/li&gt;
	&lt;li&gt;&lt;font color=&quot;#172b4d&quot;&gt;The User is in the Balance Interface&lt;/font&gt;&lt;/li&gt;
&lt;/ul&gt;


&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;When&lt;/b&gt; the user clicks the &quot;Measure&quot; button(s)&lt;/font&gt;&lt;/p&gt;

&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;Then&lt;/b&gt; the Actual Amt data will be captured from the selected equipment for Direct weigh method or calculated for Residual Difference and Difference and committed to the Preparation Sub table to the applicable |RfC suffix columns or metadata column&lt;/font&gt;&lt;/p&gt;

&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;2) Re-Measure button&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;

&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;Given&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;
&lt;ul&gt;
	&lt;li&gt;&lt;font color=&quot;#172b4d&quot;&gt;A Signals Experiment using a&#160;&lt;b&gt;GxP-GMP&lt;/b&gt;&#160;Template with&lt;/font&gt;
	&lt;ul&gt;
		&lt;li&gt;&lt;font color=&quot;#172b4d&quot;&gt;one or more hub-connected pH meter in the Equipment Table (Equipment Class = pH meter)&lt;/font&gt;&lt;/li&gt;
		&lt;li&gt;&lt;font color=&quot;#172b4d&quot;&gt;GxP-GMP Table Template Preparation Master with RfC| prefix and |RfC suffix columns (with external action) with one or more preparations&lt;/font&gt;&lt;/li&gt;
	&lt;/ul&gt;
	&lt;/li&gt;
	&lt;li&gt;&lt;font color=&quot;#172b4d&quot;&gt;The User is in the Balance Interface UI&lt;/font&gt;&lt;/li&gt;
&lt;/ul&gt;


&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;When&lt;/b&gt; the Actual Amt already has previous value&lt;/font&gt;&lt;/p&gt;

&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;Then&lt;/b&gt; the UI will display the previous values and a &quot;Re-Measure&quot; button is displayed in stead of the &quot;Measure&quot; for all weighing methods (Direct, Residual Difference and Difference) in line with the preparation containing already measured data&lt;/font&gt;&lt;/p&gt;

&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;3) Actions linked to Re-Measure button&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;

&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;Given&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;
&lt;ul&gt;
	&lt;li&gt;&lt;font color=&quot;#172b4d&quot;&gt;Actual Amt already has previous value(s) and &quot;Re-Measure&quot; button(s) is displayed&lt;/font&gt;&lt;/li&gt;
&lt;/ul&gt;


&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;When&lt;/b&gt; the User clicks the &quot;Re-Measure&quot; button(s)&lt;/font&gt;&lt;/p&gt;

&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;Then&lt;/b&gt;&#160;the UI will display&lt;/font&gt;&lt;/p&gt;
&lt;ul&gt;
	&lt;li&gt;&lt;font color=&quot;#172b4d&quot;&gt;a Reason for Change - dropdown field to be populated with the attribute list &quot;GxP Reason for change data tables&quot;&lt;/font&gt;&lt;/li&gt;
	&lt;li&gt;&lt;font color=&quot;#172b4d&quot;&gt;a Comments field - free text field&lt;/font&gt;&lt;/li&gt;
	&lt;li&gt;&lt;font color=&quot;#172b4d&quot;&gt;inactive &quot;Measure&quot; button(s)&lt;/font&gt;&lt;/li&gt;
&lt;/ul&gt;


&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;4) Executing (Re-)Measurement&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;

&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;Given&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;
&lt;ul&gt;
	&lt;li&gt;&lt;font color=&quot;#172b4d&quot;&gt;The user has populated the mandatory reason for change and the &quot;Measure&quot; button(s) is activated&lt;/font&gt;&lt;/li&gt;
&lt;/ul&gt;


&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;When&lt;/b&gt; the user clicks the &quot;Measure&quot; button(s)&lt;/font&gt;&lt;/p&gt;

&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;Then&lt;/b&gt;&#160;the system will&lt;/font&gt;&lt;/p&gt;
&lt;ul&gt;
	&lt;li&gt;&lt;font color=&quot;#172b4d&quot;&gt;re-measure the Actual Amt or Difference weights (re-calculation Actual Amt)&lt;/font&gt;&lt;/li&gt;
	&lt;li&gt;&lt;font color=&quot;#172b4d&quot;&gt;overwrite the previous values with the new values in the UI and commit the measured data to the table, to the applicable |RfC suffix columns or metadata column&lt;/font&gt;&lt;/li&gt;
	&lt;li&gt;&lt;font color=&quot;#172b4d&quot;&gt;Concatenate the Reason for change and comment fields with a &quot;-&quot; and commit this to the RfC| prefix columns (RfC| Actual Amt)&lt;/font&gt;&lt;br/&gt;
&lt;font color=&quot;#172b4d&quot;&gt;Note: one reason for change is required for both measurement using the Residual Difference or Difference weigh methods&lt;/font&gt;&lt;/li&gt;
&lt;/ul&gt;


&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;5) Log user details in experiment history&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;

&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;Given&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;
&lt;ul&gt;
	&lt;li&gt;&lt;font color=&quot;#172b4d&quot;&gt;a Signals Experiment with a GxP-GMP General template&lt;/font&gt;&lt;/li&gt;
&lt;/ul&gt;


&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;When&lt;/b&gt;&#160;the user triggers the external action&lt;/font&gt;&lt;/p&gt;

&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;Then&lt;/b&gt;&#160;the user&#160;details of the user triggering the external action must be logged in the experiment history (audit trail) not the service account&lt;/font&gt;&lt;/p&gt;</customfieldvalue>

                        </customfieldvalues>
                    </customfield>
