                <customfields>
                                                <customfield id="customfield_10300" key="com.atlassian.jira.plugin.system.customfieldtypes:textarea">
                        <customfieldname>Acceptance Criteria</customfieldname>
                        <customfieldvalues>
                            <customfieldvalue>&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;Preconditions&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;
&lt;ul class=&quot;alternate&quot; type=&quot;square&quot;&gt;
	&lt;li&gt;&lt;font color=&quot;#172b4d&quot;&gt;Given the experiment uses a GxP-GMP template (Release 3.0.0 and Release 3.1.0).&lt;/font&gt;&lt;/li&gt;
	&lt;li&gt;&lt;font color=&quot;#172b4d&quot;&gt;And the user has an active Signals session&lt;/font&gt;&lt;/li&gt;
	&lt;li&gt;&lt;font color=&quot;#172b4d&quot;&gt;And the user navigates to the Experiment Audit Trail page for that experiment&lt;/font&gt;&lt;/li&gt;
&lt;/ul&gt;


&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;1a) Experiment audit trail data is available - button&lt;/b&gt;&#160;&lt;/font&gt;&lt;/p&gt;

&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;Given&lt;/b&gt;&#160;the experiment has an experiment audit trail&#160;report generated (ad hoc or via signoff)&lt;/font&gt;&lt;br/&gt;
&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;When&lt;/b&gt; the user opens the Experiment Audit Trail page and enters the experiment ID (eg. GMP000001) and clicks &quot;search&quot;&lt;/font&gt;&lt;br/&gt;
&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;Then&lt;/b&gt; a button &quot;Browse Audit Trail&quot; to display the audit trail table is available.&lt;/font&gt;&lt;/p&gt;

&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;1b) Experiment audit trail data is available - audit trail table&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;

&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;Given&lt;/b&gt; the button to display the audit trail table is available&lt;/font&gt;&lt;br/&gt;
&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;When&lt;/b&gt; the user click the button &quot;Browse Audit Trail&quot;&lt;/font&gt;&lt;br/&gt;
&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;Then&lt;/b&gt; a table with the audit trail data is&#160;displayed with columns: Date/Time, User Name, User ID, Entity Type, Entity Name, Action, Change Type, Details, Old Value, New Value, Event ID&lt;/font&gt;&lt;br/&gt;
&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;And&lt;/b&gt;&#160;a global search field is displayed above the table&lt;/font&gt;&lt;br/&gt;
&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;And&lt;/b&gt;&#160;sortable column headers show sorting arrows&lt;/font&gt;&lt;br/&gt;
&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;And&lt;/b&gt;&#160;pagination controls (page numbers, previous/next, page-size selector) are displayed below the table&lt;/font&gt;&lt;br/&gt;
&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;And&lt;/b&gt; the content of the table is identical to the export (Excel, PDF).&lt;/font&gt;&lt;/p&gt;

&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;2a) Search - matching records found&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;

&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;Given&lt;/b&gt;&#160;the audit trail table is displayed with data&lt;/font&gt;&lt;br/&gt;
&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;When&lt;/b&gt;&#160;the user enters a search term that matches one or more rows&lt;/font&gt;&lt;br/&gt;
&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;Then&lt;/b&gt;&#160;only the rows matching the search term are displayed&lt;/font&gt;&lt;br/&gt;
&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;And&lt;/b&gt;&#160;the record count and pagination reflect the filtered result set&lt;/font&gt;&lt;/p&gt;

&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;2b) Search - no matching records&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;

&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;Given&lt;/b&gt;&#160;the audit trail table is displayed with data&lt;/font&gt;&lt;br/&gt;
&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;When&lt;/b&gt;&#160;the user enters a search term that matches no row&lt;/font&gt;&lt;br/&gt;
&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;Then&lt;/b&gt; a notification &quot;No matching records found&quot; is displayed&lt;/font&gt;&lt;/p&gt;

&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;3a) Sorting - ascending / descending per column&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;

&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;Given&lt;/b&gt;&#160;the audit trail table is displayed with data&lt;/font&gt;&lt;br/&gt;
&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;When&lt;/b&gt;&#160;the user clicks a sortable column header&lt;/font&gt;&lt;br/&gt;
&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;Then&lt;/b&gt;&#160;the table is sorted ascending by that column, indicated by the sort arrow&lt;/font&gt;&lt;br/&gt;
&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;When&lt;/b&gt;&#160;the user clicks the same column header again&lt;/font&gt;&lt;br/&gt;
&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;Then&lt;/b&gt;&#160;the table is sorted descending by that column, indicated by the sort arrow&lt;/font&gt;&lt;/p&gt;

&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;3b) Sorting - multi-column&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;

&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;Given&lt;/b&gt;&#160;the audit trail table is already sorted by one column&lt;/font&gt;&lt;br/&gt;
&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;When&lt;/b&gt;&#160;the user shift-clicks a second sortable column header&lt;/font&gt;&lt;br/&gt;
&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;Then&lt;/b&gt; the table is sorted first by the initial column and then by the second column, both indicated by sort arrows&lt;/font&gt;&lt;/p&gt;

&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;4a) Pagination - user page-size options&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;

&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;Given&lt;/b&gt;&#160;the audit trail table contains more rows than the current page size&lt;/font&gt;&lt;br/&gt;
&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;When&lt;/b&gt;&#160;the user selects a different page-size option from the page-size selector&lt;/font&gt;&lt;br/&gt;
&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;Then&lt;/b&gt;&#160;the table displays the selected number of rows per page&lt;/font&gt;&lt;br/&gt;
&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;And&lt;/b&gt;&#160;the pagination controls update accordingly&lt;/font&gt;&lt;/p&gt;

&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;4b) Pagination - default page size&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;

&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;Given&lt;/b&gt; the audit trail table contains more rows than the current page size&lt;/font&gt;&lt;/p&gt;

&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;When&lt;/b&gt; the user opens the Experiment Audit Trail page for the first time&lt;/font&gt;&lt;br/&gt;
&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;Then&lt;/b&gt; no page-size selection has been made&lt;/font&gt;&lt;br/&gt;
&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;Then&lt;/b&gt; the table displays the default page size of 25 rows&lt;/font&gt;&lt;/p&gt;

&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;5) Experiment audit trail data is not available&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;

&lt;p&gt;&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;Given&lt;/b&gt; the experiment has &lt;b&gt;no&lt;/b&gt; experiment audit trail&#160;report generated (ad hoc or via signoff)&lt;/font&gt;&lt;br/&gt;
&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;When&lt;/b&gt; the user opens the Experiment Audit Trail page and enters the experiment ID (eg. GMP000001)&lt;/font&gt;&lt;br/&gt;
&lt;font color=&quot;#172b4d&quot;&gt;&lt;b&gt;Then&lt;/b&gt; a message is displayed to inform the user no audit trail data is available (Ref. &lt;a href=&quot;https://jira.jnj.com/browse/JGVT-2698&quot; title=&quot;Reports_Audit Trail: download audit trail report via web user interface&quot; class=&quot;issue-link&quot; data-issue-key=&quot;JGVT-2698&quot;&gt;&lt;del&gt;JGVT-2698&lt;/del&gt;&lt;/a&gt;)&lt;/font&gt;&lt;/p&gt;</customfieldvalue>

                        </customfieldvalues>
                    </customfield>
