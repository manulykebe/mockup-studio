                <customfields>
                                                <customfield id="customfield_10300" key="com.atlassian.jira.plugin.system.customfieldtypes:textarea">
                        <customfieldname>Acceptance Criteria</customfieldname>
                        <customfieldvalues>
                            <customfieldvalue>&lt;ol&gt;
	&lt;li&gt;&lt;b&gt;System Audit&lt;/b&gt;&#160;&lt;b&gt;Trail Request - UI&lt;/b&gt;&lt;br/&gt;
&lt;b&gt;Given&lt;/b&gt; a Signals active session&#160;&lt;br/&gt;
&lt;b&gt;When&lt;/b&gt; the User requests an ad hoc system audit trail report via a web UI (&quot;System audit trail report&quot;) or o&lt;font color=&quot;#172b4d&quot;&gt;n the dashboard via web link widget&lt;/font&gt;&lt;br/&gt;
&lt;b&gt;Than&lt;/b&gt;&#160;The system will open an UI with the following details
	&lt;ol&gt;
		&lt;li&gt;Title 1: Generate System Audit Trail Report&lt;/li&gt;
		&lt;li&gt;Note: The report will take a minimum of 30 min to generate and contain SAT data from the first day of the selected month until the current day (if month has not ended) or last day of the selected month.&lt;/li&gt;
		&lt;li&gt;Start SATR Request for:
		&lt;ol&gt;
			&lt;li&gt;Month drop down field prepopulated with Month in full name format (eg. January, February, March,...)&lt;/li&gt;
			&lt;li&gt;Year drop down field prepopulated with Year in yyyy format starting from 2025 up to current year (also for future years)&lt;/li&gt;
			&lt;li&gt;Request button&lt;/li&gt;
		&lt;/ol&gt;
		&lt;/li&gt;
		&lt;li&gt;Title 2: Download System Audit Trail Report&lt;/li&gt;
		&lt;li&gt;SAT Report:
		&lt;ol&gt;
			&lt;li&gt;dropdown field prepopulated with Month in full name format (eg. January, February, March,...)&lt;/li&gt;
			&lt;li&gt;Year drop down field prepopulated with Year in yyyy format starting from 2025 up to current year (also for future years)&lt;/li&gt;
			&lt;li&gt;Search button&lt;/li&gt;
			&lt;li&gt;Download Excel button&lt;/li&gt;
			&lt;li&gt;Field for user notification in case report is not yet ready for download (&lt;a href=&quot;https://jira.jnj.com/browse/JGVT-2569&quot; title=&quot;Reports_Audit Trail: download System Audit Trail report via web user interface&quot; class=&quot;issue-link&quot; data-issue-key=&quot;JGVT-2569&quot;&gt;&lt;del&gt;JGVT-2569&lt;/del&gt;&lt;/a&gt;)&lt;/li&gt;
		&lt;/ol&gt;
		&lt;/li&gt;
	&lt;/ol&gt;
	&lt;/li&gt;
	&lt;li&gt;&lt;b&gt;System Audit&lt;/b&gt;&#160;&lt;b&gt;Trail data processing&lt;/b&gt;&lt;br/&gt;
&lt;b&gt;Given&lt;/b&gt; a Signals active session&lt;br/&gt;
&lt;b&gt;When&lt;/b&gt; the User clicks on the request button in the System audit trail report UI&lt;br/&gt;
&lt;b&gt;Then&lt;/b&gt; the System shall start extracting the configuration audit log data as per defined filter (&lt;a href=&quot;https://jira.jnj.com/browse/JGVT-2283&quot; title=&quot;Reports_Audit Trail: System Audit Trail- Excel export&quot; class=&quot;issue-link&quot; data-issue-key=&quot;JGVT-2283&quot;&gt;&lt;del&gt;JGVT-2283&lt;/del&gt;&lt;/a&gt;), via an asynchronous action, and notifies the user &quot;The system audit trail report is being generated.&quot;&lt;/li&gt;
&lt;/ol&gt;
</customfieldvalue>

                        </customfieldvalues>
